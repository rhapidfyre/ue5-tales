      </memberdef>
      <memberdef kind="function" id="class_a_creator_character_base_1ae98c8465678f324d7ff2971d74deee8b" prot="public" static="no" const="no" explicit="no" inline="no" virt="virtual">
        <type>USaveGame *</type>
        <definition>USaveGame * ACreatorCharacterBase::SaveCharacter</definition>
        <argsstring>(USaveGame *SaveObject, bool bRunAsync) override</argsstring>
        <name>SaveCharacter</name>
        <qualifiedname>ACreatorCharacterBase::SaveCharacter</qualifiedname>
        <reimplements refid="class_a_character_base_1af108e9a63b7ef7c8b439d1489907a97f">SaveCharacter</reimplements>
        <param>
          <type>USaveGame *</type>
          <declname>SaveObject</declname>
        </param>
        <param>
          <type>bool</type>
          <declname>bRunAsync</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Saves the character to file. If being saved asynchronously, the returned save object will be the updated object as it is right before the save writes to file. Triggers &apos;OnCharacterSaved&apos; upon completion (async or not). <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SaveObject</parametername>
</parameternamelist>
<parameterdescription>
<para>The save data being carried between child/parent </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>bRunAsync</parametername>
</parameternamelist>
<parameterdescription>
<para>True if the save should run asynchronously </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The <ref refid="class_u_saved_character" kindref="compound">USavedCharacter</ref> SaveGame object for this character. </para>
</simplesect>
</para>
        </detaileddescription>
